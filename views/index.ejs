<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Katalog Kopi Nusantara</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-brand">Kopi<span>Nusantara</span></div>
        <div class="cart-wrapper" onclick="toggleCart()">
            <span>Keranjang</span>
            <span id="cart-counter" class="cart-badge">0</span>

            <div id="cart-panel" class="cart-panel" onclick="event.stopPropagation()">
                <div class="cart-panel-header">
                    <h4>Keranjang Belanja</h4>
                    <button class="btn-close-cart" onclick="toggleCart()">&times;</button>
                </div>
                <div id="cart-body" class="cart-body">
                    <p class="cart-empty">Keranjang masih kosong.</p>
                </div>
            </div>
        </div>
    </nav>

    <main class="container">
        <header class="page-header">
            <h2>Koleksi Biji Kopi Spesialti</h2>
            <p>Temukan cita rasa otentik dari berbagai daerah di Indonesia.</p>
        </header>
        
        <div id="product-container" class="coffee-grid"></div>
    </main>

    <script src="/js/store.js"></script>
    <script src="/js/products.js"></script>
</body>
</html>